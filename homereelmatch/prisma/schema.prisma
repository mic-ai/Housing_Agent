generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String?
  phone           String?
  lineId          String?
  createdAt       DateTime         @default(now())
  contactRequests ContactRequest[]

  @@map("users")
}

model Company {
  id                String        @id @default(cuid())
  name              String
  address           String?
  modelHouseName    String?
  modelHouseAddress String?
  lat               Float?
  lng               Float?
  salespersons      Salesperson[]
  createdAt         DateTime      @default(now())

  @@map("companies")
}

enum SalespersonRole {
  SALESPERSON
  ADMIN
}

model Salesperson {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  SalespersonRole        @default(SALESPERSON)
  lineId                String?
  profileImage          String?
  profileDetail         String?
  toneQuote             String?
  yearsExperience       Int?
  handoverCount         Int?
  introVideoUrl         String?
  introVideoStoragePath String?
  introVideoDurationSec Int?
  company               Company?               @relation(fields: [companyId], references: [id])
  companyId             String?
  houseMaker            HouseMaker?            @relation(fields: [houseMakerId], references: [id])
  houseMakerId          String?
  videoSegments         SalespersonVideo[]
  faceVideos            SalespersonFaceVideo[]
  slots                 AvailableSlot[]
  contactRequests       ContactRequest[]
  viewerViews           ViewerSalespersonView[]
  createdAt             DateTime               @default(now())

  @@map("salespersons")
}

model SalespersonFaceVideo {
  id            String      @id @default(cuid())
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  salespersonId String
  rollType      String
  storagePath   String
  publicUrl     String
  durationSec   Int
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@map("salesperson_face_videos")
}

model HouseMaker {
  id               String                       @id @default(cuid())
  name             String                       @unique
  logoUrl          String?
  isActive         Boolean                      @default(true)
  videos           Video[]
  salespersons     Salesperson[]
  comparisonRows   ArticleComparisonRow[]
  savedByViewers   ViewerSavedMaker[]
  visitorInterests VisitorHouseMakerInterest[]
  createdAt        DateTime                     @default(now())

  @@map("house_makers")
}

model Venue {
  id        String    @id @default(cuid())
  name      String    @unique
  address   String?
  isActive  Boolean   @default(true)
  videos    Video[]
  visitors  Visitor[]
  createdAt DateTime  @default(now())

  @@map("venues")
}

model Video {
  id                String             @id @default(cuid())
  platform          Platform
  url               String
  thumbnailUrl      String?
  title             String
  description       String?
  houseMaker        HouseMaker?        @relation(fields: [houseMakerId], references: [id])
  houseMakerId      String?
  venue             Venue?             @relation(fields: [venueId], references: [id])
  venueId           String?
  viewCount         Int                @default(0)
  isActive          Boolean            @default(true)
  sortOrder         Int                @default(0)
  salespersonVideos SalespersonVideo[]
  videoHashtags     VideoHashtag[]
  viewerViews       ViewerSalespersonView[]
  visitorViews      VisitorVideoView[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("videos")
}

enum Platform {
  YOUTUBE
  INSTAGRAM
}

model SalespersonVideo {
  id                  String      @id @default(cuid())
  video               Video       @relation(fields: [videoId], references: [id])
  videoId             String
  salesperson         Salesperson @relation(fields: [salespersonId], references: [id])
  salespersonId       String
  preRollStoragePath  String?
  preRollPublicUrl    String?
  preRollDurationSec  Int?
  postRollStoragePath String?
  postRollPublicUrl   String?
  postRollDurationSec Int?
  isPrimary           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([videoId, salespersonId])
  @@map("salesperson_videos")
}

model Hashtag {
  id               String                     @id @default(cuid())
  tagName          String                     @unique
  usageCount       Int                        @default(0)
  videoHashtags    VideoHashtag[]
  visitorInterests VisitorHashtagInterest[]

  @@map("hashtags")
}

model VideoHashtag {
  id        String  @id @default(cuid())
  video     Video   @relation(fields: [videoId], references: [id])
  videoId   String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])
  hashtagId String

  @@unique([videoId, hashtagId])
  @@map("video_hashtags")
}

model ContactRequest {
  id                String        @id @default(cuid())
  user              User          @relation(fields: [userId], references: [id])
  userId            String
  salesperson       Salesperson   @relation(fields: [salespersonId], references: [id])
  salespersonId     String
  videoId           String?
  contactMethod     ContactMethod
  questionnaireJson Json?
  status            ContactStatus @default(PENDING)
  appointment       Appointment?
  visitorContact    VisitorContact?
  createdAt         DateTime      @default(now())

  @@map("contact_requests")
}

enum ContactMethod {
  LINE
  EMAIL
}

enum ContactStatus {
  PENDING
  RESPONDED
  APPOINTED
  CLOSED
}

model Appointment {
  id               String            @id @default(cuid())
  contactRequest   ContactRequest    @relation(fields: [contactRequestId], references: [id])
  contactRequestId String            @unique
  salespersonId    String
  userId           String
  scheduledAt      DateTime
  modelHouseId     String?
  status           AppointmentStatus @default(CONFIRMED)
  reminderSentAt   DateTime?
  createdAt        DateTime          @default(now())

  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AvailableSlot {
  id            String      @id @default(cuid())
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id])
  salespersonId String
  startAt       DateTime
  endAt         DateTime
  isBooked      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("available_slots")
}

// --- 学習コンテンツ（CMS管理） ---

enum ArticleDifficulty {
  BEGINNER // 入門
  BASIC // 基礎
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model LearningPhase {
  id          String    @id @default(cuid())
  key         String    @unique // "info_basic" | "maker_selection"
  title       String
  order       Int
  description String?
  isActive    Boolean   @default(true)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("learning_phases")
}

model Article {
  id                String                  @id @default(cuid())
  phaseId           String
  phase             LearningPhase           @relation(fields: [phaseId], references: [id])
  order             Int
  title             String
  bodyMarkdown      String                  @db.Text
  estimatedMinutes  Int
  difficulty        ArticleDifficulty
  translateBoxLabel String?
  translateBoxValue String?
  status            ArticleStatus           @default(DRAFT)
  publishedAt       DateTime?
  comparisonRows    ArticleComparisonRow[]
  progress          ViewerArticleProgress[]
  sources           ArticleSource[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([phaseId, order])
  @@map("articles")
}

// Web検索による下書き生成時に参照した情報源（透明性確保のため保持）
model ArticleSource {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("article_sources")
}

model ArticleComparisonRow {
  id            String      @id @default(cuid())
  articleId     String
  article       Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  houseMakerId  String?
  houseMaker    HouseMaker? @relation(fields: [houseMakerId], references: [id])
  priceRangeTag String? // 動画フィルター引き継ぎ用（既存Hashtagの値と一致させる運用）
  featureTag    String? // 同上
  order         Int         @default(0)

  @@map("article_comparison_rows")
}

// --- 閲覧ユーザーの軽量識別・進捗管理 ---

model ViewerProfile {
  id               String                   @id @default(cuid())
  viewerToken      String                   @unique
  createdAt        DateTime                 @default(now())
  lastSeenAt       DateTime                 @updatedAt
  articleProgress  ViewerArticleProgress[]
  salespersonViews ViewerSalespersonView[]
  savedMakers      ViewerSavedMaker[]
  visitors         Visitor[]
  visitorVideoViews VisitorVideoView[]
  agentConversations AgentConversation[]

  @@map("viewer_profiles")
}

model ViewerArticleProgress {
  id          String        @id @default(cuid())
  viewerId    String
  viewer      ViewerProfile @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([viewerId, articleId])
  @@map("viewer_article_progress")
}

model ViewerSalespersonView {
  id            String        @id @default(cuid())
  viewerId      String
  viewer        ViewerProfile @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  salespersonId String
  salesperson   Salesperson   @relation(fields: [salespersonId], references: [id])
  videoId       String?
  video         Video?        @relation(fields: [videoId], references: [id])
  viewCount     Int           @default(1)
  lastViewedAt  DateTime      @updatedAt

  @@unique([viewerId, salespersonId])
  @@map("viewer_salesperson_views")
}

model ViewerSavedMaker {
  id           String        @id @default(cuid())
  viewerId     String
  viewer       ViewerProfile @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  houseMakerId String
  houseMaker   HouseMaker    @relation(fields: [houseMakerId], references: [id])
  createdAt    DateTime      @default(now())

  @@unique([viewerId, houseMakerId])
  @@map("viewer_saved_makers")
}

// --- 展示場 来場者トラッキング（Step1） ---

model Visitor {
  id                 String                      @id @default(cuid())
  visitDate          DateTime                    @default(now())
  venueId            String?
  venue              Venue?                      @relation(fields: [venueId], references: [id])
  consentGiven       Boolean                     @default(false)
  consentedAt        DateTime?
  lineOptIn          Boolean                     @default(false)
  lineOptInAt        DateTime?
  viewerId           String?
  viewer             ViewerProfile?              @relation(fields: [viewerId], references: [id])
  interestedMakers   VisitorHouseMakerInterest[]
  interestedHashtags VisitorHashtagInterest[]
  videoViews         VisitorVideoView[]
  contacts           VisitorContact[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([viewerId])
  @@index([visitDate])
  @@map("visitors")
}

model VisitorHouseMakerInterest {
  id           String     @id @default(cuid())
  visitorId    String
  visitor      Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  houseMakerId String
  houseMaker   HouseMaker @relation(fields: [houseMakerId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([visitorId, houseMakerId])
  @@map("visitor_house_maker_interests")
}

model VisitorHashtagInterest {
  id        String   @id @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id])
  createdAt DateTime @default(now())

  @@unique([visitorId, hashtagId])
  @@map("visitor_hashtag_interests")
}

model VisitorVideoView {
  id        String        @id @default(cuid())
  visitorId String?
  visitor   Visitor?      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    ViewerProfile @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?        @relation(fields: [videoId], references: [id])
  source    String
  viewedAt  DateTime      @default(now())

  @@index([visitorId])
  @@index([viewerId])
  @@index([source])
  @@map("visitor_video_views")
}

model VisitorContact {
  id               String          @id @default(cuid())
  visitorId        String
  visitor          Visitor         @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  converted        Boolean         @default(false)
  contactChannel   ContactMethod?
  contactRequestId String?         @unique
  contactRequest   ContactRequest? @relation(fields: [contactRequestId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([visitorId])
  @@map("visitor_contacts")
}

// --- 中立的AIエージェント（層1） ---

enum AgentMessageRole {
  USER
  ASSISTANT
}

model AgentConversation {
  id             String         @id @default(cuid())
  viewerId       String
  viewer         ViewerProfile  @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  conditionsJson Json?
  messages       AgentMessage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([viewerId])
  @@map("agent_conversations")
}

model AgentMessage {
  id                     String            @id @default(cuid())
  conversationId         String
  conversation           AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                   AgentMessageRole
  content                String            @db.Text
  candidateHouseMakerIds Json? // string[]。DB検証後の確定IDのみ(ASSISTANTのみ)
  referencedKnowledgeIds Json? // string[]。PUBLISHEDのみ(ASSISTANTのみ)
  createdAt              DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

enum AgentKnowledgeStatus {
  DRAFT
  PUBLISHED
}

model AgentKnowledgeEntry {
  id           String                 @id @default(cuid())
  topic        String
  category     String
  title        String
  bodyMarkdown String                 @db.Text
  status       AgentKnowledgeStatus   @default(DRAFT)
  publishedAt  DateTime?
  sources      AgentKnowledgeSource[]
  sourceGroup  AgentKnowledgeSourceGroup?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, category])
  @@map("agent_knowledge_entries")
}

// Web検索により参照した情報源(ArticleSourceと同じ透明性確保パターン)
model AgentKnowledgeSource {
  id        String              @id @default(cuid())
  entryId   String
  entry     AgentKnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime            @default(now())

  @@index([entryId])
  @@map("agent_knowledge_sources")
}

// --- AIナレッジ: 登録済み参考ソース(URL/PDF)からの自動クロール生成 ---

enum AgentKnowledgeSourceType {
  URL
  PDF
}

model AgentKnowledgeSourceGroup {
  id            String                           @id @default(cuid())
  topic         String
  category      String
  entryId       String?                          @unique
  entry         AgentKnowledgeEntry?              @relation(fields: [entryId], references: [id], onDelete: SetNull)
  sources       AgentKnowledgeRegisteredSource[]
  lastCrawledAt DateTime?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  @@index([category])
  @@map("agent_knowledge_source_groups")
}

model AgentKnowledgeRegisteredSource {
  id          String                    @id @default(cuid())
  groupId     String
  group       AgentKnowledgeSourceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sourceType  AgentKnowledgeSourceType
  url         String?
  storagePath String?
  publicUrl   String?
  fileName    String?
  title       String?
  createdAt   DateTime                  @default(now())

  @@index([groupId])
  @@map("agent_knowledge_registered_sources")
}
